# ---------------------------------------------------------------------------
# LOG POSE environment configuration
#
# Live Mode walking routes and OpenStreetMap safety indicators work with NO
# configuration at all. Supabase is only needed for the verified Safe Haven
# network, and ADMIN_TOKEN only for the /admin verification dashboard.
# ---------------------------------------------------------------------------

# Verified Safe Haven network (optional).
# Without these, routing and OSM safety indicators still work and Safe Haven
# availability is honestly reported as unavailable instead of being faked.
# Supabase dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY -- never prefix with NEXT_PUBLIC_, never commit a real value.
# Required for the /admin verification workflow.
# Supabase dashboard > Project Settings > API > service_role secret
SUPABASE_SERVICE_ROLE_KEY=

# SERVER ONLY -- shared password for the /admin dashboard.
# Generate a long random value, e.g.: openssl rand -base64 32
ADMIN_TOKEN=

# Walking router (optional). Defaults to the FOSSGIS / OpenStreetMap.de OSRM
# instance, which hosts the real `foot` profile.
# Do NOT point this at router.project-osrm.org: that demo server only serves
# the car profile, so it returns driving times for walking requests.
NEXT_PUBLIC_OSRM_URL=https://routing.openstreetmap.de/routed-foot

# Overpass API endpoint (optional). Public mirrors are tried automatically.
OVERPASS_URL=
